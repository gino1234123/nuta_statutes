#set page(
  paper: "a4",
  margin: (
    x: 3cm,
    y: 2.5cm,
  ),
)

#set text(
  font: (
  (name: "Times New Roman", covers: "latin-in-cjk"),
  "TW-Kai"),
  size: 12pt,
  lang: "zh",
  region: "TW"
)


#let chapter-counter = counter("chapter")
#let article-counter = counter("article")

// 阿拉伯數字轉中文小寫（1..9999）
#let to-cjk(n) = {
  let d = ("零", "一", "二", "三", "四", "五", "六", "七", "八", "九")
  if n <= 0 {
    "零"
  } else if n < 10 {
    d.at(n)
  } else if n < 100 {
    let t = calc.floor(n / 10)
    let o = calc.rem(n, 10)
    if t == 1 {
      if o == 0 { "十" } else { "十" + d.at(o) }
    } else {
      if o == 0 { d.at(t) + "十" } else { d.at(t) + "十" + d.at(o) }
    }
  } else if n < 1000 {
    let h = calc.floor(n / 100)
    let r = calc.rem(n, 100)
    if r == 0 {
      d.at(h) + "百"
    } else if r < 10 {
      d.at(h) + "百零" + d.at(r)
    } else {
      d.at(h) + "百" + to-cjk(r)
    }
  } else if n < 10000 {
    let th = calc.floor(n / 1000)
    let r = calc.rem(n, 1000)
    if r == 0 {
      d.at(th) + "千"
    } else if r < 100 {
      d.at(th) + "千零" + to-cjk(r)
    } else {
      d.at(th) + "千" + to-cjk(r)
    }
  } else {
    str(n)
  }
}

// 文件標題
#show heading.where(level: 1): it => {
  align(center)[
    #text(18pt, weight: "bold")[
      #it.body
    ]
  ]
}

// 章
#show heading.where(level: 2): it => {
  context {
    let n = chapter-counter.get().first() + 1

    chapter-counter.step()
    
    v(2em)

    align(center)[
      #text(14pt, weight: "bold")[
        第#to-cjk(n)章　#it.body
      ]
    ]

  }
}

// 條（建議使用 #article[...]，可同條換行/分段）
#let article(body) = {
  context {
    let n = article-counter.get().first() + 1
    article-counter.step()
    v(1.5em)
    block[
      #text[第#to-cjk(n)條]
      #par(hanging-indent: 1em, first-line-indent: 1em)[#body]
    ]
  }
}


= 國立臺灣藝術大學學生會組織章程

== 總綱
#article[
  依據大學法第三十三條及本校大學組織規程第四章第三十七條規定制定本校學生會（以下簡稱本會）組織章程，以為本會員共尊共守。]

#article[
定名為「國立臺灣藝術大學學生會」。
]

#article[
本會為本校大學學生之最高自治單位。
]

#article[
本會由行政機構稱「行政中心」、立法機構稱「學生議會」二個機構組成之。
]

#article[
凡本校之在學學生均為本會會員。
]

#article[
會員應繳納會費，並享有應有之權利，得遵循本章程所定程序，參與本會會務。
]

#article[
本會之輔導單位為學生事務處課外活動指導組。
]

== 行政中心

#article[
本會置會長一人，對外代表本會，對內領導行政中心總攬會務，任期一學年，連選得連任一屆。\
本會置副會長一人，協助會長處理本會對校內、外事宜。\
第一項及第二項職務之選舉罷免，以法律定之。
]

#article[
行政中心得依需求設立若干部門，以協助會長處理會務，\
]

#article[
會長因故不能行使職權或出缺時，由副會長代理或繼任。正副會長皆不能行使職權或出缺時，由學生議會議長代行日常會務，如距原任會長任期屆滿之日四個月以上，應舉辦補選。
]

== 學生議會

#article[
學生議會應監督行政中心，審議預算案、決算案及其他議案，並依需要制定或修正與本會事務相關之法律。\
]

#article[
學生議會職權行使應經正當程序，其規範以法律定之。\
學生議會進行任何決議應由多數決為之。
]

#article[
學生議會置議員十五人，代表本會會員，任期一學年，得連續擔任。\
議員之選舉罷免，以法律定之。\
前項選舉產生之議員不足額時，由各系學會長中抽籤若干人補足之。\
前項系學會長若無擔任議員之意願，應推舉該系同學一人代替。\
議員應親自出席會議，不得委託他人行使職權。
]

#article[
學生議會應自行召開常會，由任期開始至結束以每月召開一次為原則。
]

#article[
  議員不得兼任會長、副會長及行政中心部門首長。
]

#article[
學生議會置議長一人，由議員互選產生，連選得連任，負責主持學生議會之會議。\
議長因故不能行使職權，由議員互選一人代理之，若其因出缺致不能行使職權者，應另行補選。
]

#article[
  學生議會設秘書處，負責處理學生議會會議事務。
  秘書處置秘書長一人，由議長任命之。
  秘書處對於議案審議之議程安排，僅應就時間序安排之，不得任意調動。
]

== 行政與立法互動

#article[
行政中心施政對學生議會負責，學生議會得依需求質詢或糾正行政中心相關部門首長。\
前項質詢及糾正之程序，以法律定之。
]

#article[
行政中心欲支用款項應向學生議會提請預算案，經學生議會審議通過者方可支用。\
學生議會審議預算案得刪減或附加條件，惟不得做增加預算之決議，並得要求行政中心相關部門首長列席說明或予以質詢。
]

#article[
  行政中心之預算案，分小型預算案及普通預算案，其分類方法於下列：\
  符合下列任一條件者，為小型預算案：\
  　　一、維護行政中心日常運作之最低整體所需經費。\
  　　二、小於新臺幣五萬元以下之活動整體所需經費。\
  符合下列任一條件者，為普通預算案：\
  　　一、涉及對外契約之整體所需經費。\
  　　二、跨會長任期之長期計劃所需經費。\
  　　三、全校性或對外之大型活動整體所需經費。\
  預算案有同時符合小型預算案及普通預算案之條件者，歸普通預算案。\
 不符合前述條件或對分類有所爭議者，歸普通預算案。\
 行政中心不得以拆案等不正當手段使應為普通預算案者為小型預算案。\
]

#article[
  小型預算案於學生議會收受之隔日起三十日內，應完成審議。\
  前項逾期未完成審議者，該小型預算案視為生效。\
  經前項程序生效之小型預算案，於生效之隔日起七日內，經議員法定總額三分之ㄧ以上連署提出否決案者，議會應於三日內召開會議審議，並議員法定總額過半數同意否決，該預算案立即失效。且不得再依本條之程序再次生效。
]

#article[
  普通預算案之審議，以法律定之。
]

#article[
學生議會通過之法律案，由會長於通過隔日之三日內公佈後實行，唯認為其窒礙難行時，得向學生議會提請覆議，但經出席議員三分之二以上同意否決者，應即接受並公佈之。
]

== 附則

#article[
  本會之所有法規範，牴觸本章程者無效。
]

#article[
  本章程之修訂，應由議員或會長提出章程修正案，提請學生議會審議，經議員法定總額三分之二以上出席者方得開會審議，議員法定總額過半數同意修正者，即通過章程修正案。\
  章程修正案通過後，應由會長於通過隔日之三日內公佈後實行，會長不得拒絕公佈。
]

#article[
  本章程於某時間實行。
]