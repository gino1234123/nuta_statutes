#set page(
  paper: "a4",
  margin: (
    x: 3cm,
    y: 2.5cm,
  ),
)

#set text(
  font: (
  (name: "Times New Roman", covers: "latin-in-cjk"),
  "Noto Serif TC"),
  size: 12pt,
  lang: "zh",
  region: "TW"
)


#let chapter-counter = counter("chapter")
#let article-counter = counter("article")

// 阿拉伯數字轉中文小寫（1..9999）
#let to-cjk(n) = {
  let d = ("零", "一", "二", "三", "四", "五", "六", "七", "八", "九")
  if n <= 0 {
    "零"
  } else if n < 10 {
    d.at(n)
  } else if n < 100 {
    let t = calc.floor(n / 10)
    let o = calc.rem(n, 10)
    if t == 1 {
      if o == 0 { "十" } else { "十" + d.at(o) }
    } else {
      if o == 0 { d.at(t) + "十" } else { d.at(t) + "十" + d.at(o) }
    }
  } else if n < 1000 {
    let h = calc.floor(n / 100)
    let r = calc.rem(n, 100)
    if r == 0 {
      d.at(h) + "百"
    } else if r < 10 {
      d.at(h) + "百零" + d.at(r)
    } else {
      d.at(h) + "百" + to-cjk(r)
    }
  } else if n < 10000 {
    let th = calc.floor(n / 1000)
    let r = calc.rem(n, 1000)
    if r == 0 {
      d.at(th) + "千"
    } else if r < 100 {
      d.at(th) + "千零" + to-cjk(r)
    } else {
      d.at(th) + "千" + to-cjk(r)
    }
  } else {
    str(n)
  }
}

// 文件標題
#show heading.where(level: 1): it => {
  align(center)[
    #text(18pt, weight: "bold")[
      #it.body
    ]
  ]
}

// 章
#show heading.where(level: 2): it => {
  context {
    let n = chapter-counter.get().first() + 1

    chapter-counter.step()
    
    v(2em)

    align(center)[
      #text(14pt, weight: "semibold")[
        第#to-cjk(n)章　#it.body
      ]
    ]

  }
}

// 條（建議使用 #article[...]，可同條換行/分段）
#let article(body) = {
  context {
    let n = article-counter.get().first() + 1
    article-counter.step()
    v(1.5em)
    block[
      #text(weight: "bold")[第#to-cjk(n)條]
      #par(leading: 1.2em, hanging-indent: 1em, first-line-indent: 1em)[#body]
    ]
  }
}

= 國立臺灣藝術大學學生會學生議會職權行使法

== 總則

#article()[
  本法依國立臺灣藝術大學學生會組織章程與學生議會相關之規定制定之。
]

#article()[
  學生議會應在議員任期開始之日起七天內舉行預備會議。\
  預備會議由前屆秘書處召集，進行議員報到、宣誓就職、議長選舉及議決該會期常會時間。\
  若前屆秘書處不為召集，得由新屆議員自行召集之。
]

#article()[
  學生議會舉行會議，除法規另有規定外，須有議員總額過半數出席，始得開會。\
  前項議員總額，以每屆實際報到之議員總數為計算標準，但若有在任期中辭職、去職或亡故，而無補足者，應扣除之。
]

#article()[
  除法規另有規定外，學生議會通過決議應以出席議員過半數為之。
]

#article()[
  出席會議，應由議員親自為之。
]

== 議案審議及會議程序

#article()[
  學生議會會議之主席由議長擔任。
]

#article()[
  學生議會應定期召開常會，除經會議議決調整時間者，議長或秘書處不得任意調整。\
  除常會外，得由會長或議員總額五分之一以上向秘書處咨請召開臨時會。\
  秘書處收受前項之咨請後，應向全體議員徵詢開會時間，並應安排於距收受咨請之隔日起七日後之最近可行時間。
]

#article()[
	會議之議程，由秘書處負責編撰之。\
  議案審議之議程安排，僅應就收受時間序安排之，不得任意調動。\
	議程應於會議舉行之前兩日，由全體議員可合理取得資訊之管道付予議員。
]

#article()[
  議案之提出，以書面或以文書型式經由通訊網路向秘書處提出。如屬法律案，應附條文及立法理由。\
  提案除議員本人外應有一人以上連署或附議。\
]

#article()[
  行政中心各部門或會長亦得提出議案，其程序準用本法第六條第一項之規定。
  前項由行政中心部門提出之議案，應經會長簽署。
]

#article()[
  議案應於會議舉行之五日前，提出予秘書處，逾期未提出者，於當次會議不予列入議程。
]

#article()[
  學生議會審議議案，除章程修正案須經三讀會議為之，其餘議案除本會法規另有規定外，均經二讀會議為之。\
]

#article()[
  第一讀會，由主席將議案宣付朗讀行之。\
  提案人或提案單位得於議案朗讀完畢後，說明其提案主旨及緣由，經大體討論，議決交付第二讀會審查或不予審議。
]

#article()[
  第二讀會，由審議第一讀會交付之議案行之。\
  第二讀會，於議案朗讀後，先就提案主旨及緣由進行廣泛討論，再依次或逐條提付討論。\
  廣泛討論後，如有出席議員提議及另一議員附議，經表決通過，得重付第一讀會審查或將議案撤銷之。\
  第二項之逐條討論，得就議案逐條表決、分部表決或全案表決。\
  逐條討論有一部分已經表決通過，其餘仍在進行中時，得由出席議員提議及另一議員附議，經表決通過，將全案重付審查，但以一次為限。
]

#article()[
  第三讀會，應於第二讀會之下次會議行之。但如有出席議員提議及另兩議員附議，經表決通過，得於二讀後繼續進行三讀。\
  第三讀會，除發現議案內容有互相牴觸，或與組織章程、其他法律相牴觸者外，祇得為文字之修正。\
  第三讀會，應將議案全案交付表決。
]

#article()[
  議案於完成二讀前，原提案人或提案單位得經大會同意後撤回議案。\
  議案交付審查後，性質相同者，得併案審查。
]

#article()[
  每屆議員任期屆滿時，除預算案及決算案外，尚未議決之議案，下屆不予繼續審議。\
  前項不予繼續審議之議案，得於新屆重新提出之。
]

== 監督、質詢及糾正

#article()[
  會長應於其任期開始後之學生議會第一次常會，提出施政方針並向大會口頭報告之。\
  施政方針應以書面或以文書型式經由通訊網路，於學生議會第一次常會之五日前送交秘書處。\
]

#article()[
  議員得於會長口頭報告施政方針完畢後，現場提出質詢。
]

#article()[
  議員得就監督行政中心施政為質詢，並得要求會長或行政中心各部門部長列席常會行之。\
  前項議員欲為質詢者，應向秘書處於常會舉行十四日前，向秘書處登記欲質詢之主旨及質詢對象。\
  前項之質詢對象，應由秘書處最遲於常會舉行七日前通知之。
]

#article()[
  議員應就其質詢主旨之範圍內為質詢，如超出範圍者，主席得制止之。\
  議員之質詢時間，不得逾十五分鐘，如超出者，主席應提醒議員結束質詢。\
]

#article()[
  被質詢人有義務答覆質詢。\
  被質詢人之答覆，不應超出質詢範圍，如超出者，主席得制止之。\
  被質詢人除為保守秘密外，不得拒絕答覆。\
  被質詢人答覆質詢應以即時為原則，但經質詢人同意者，得由書面或以文書型式經由通訊網路，於十四日內答覆之。\
]

#article()[
  質詢之事項，不得作為該會議討論之議題。
]

