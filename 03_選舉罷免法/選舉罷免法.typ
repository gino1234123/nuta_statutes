= 國立臺灣藝術大學學生會選舉罷免法

== 總則

#article()[
  #para[組織章程規定以選舉罷免產生之職位，依本法規定辦理。]
]

#article()[
  #para[本會之選舉罷免，依本法規定辦理，並以普通、平等、直接、無記名方式為之。但有特別規定者，從其規定。]
]

== 選舉罷免機關

#article()[
  #para()[本會選舉罷免事務，由選舉委員會負責辦理。]
]

#article()[
  #para()[選舉委員會隸屬本會行政機關，依法獨立行使職權，置選舉委員七人，任期一年，以其中一人為主任委員，選舉委員之產生依下列規定：]
  #subpara()[主任委員遇下列情形，由副會長擔任之：]
  #item()[（一）會長副會長選舉，現任正副會長無競選連任時。]
  #item()[（二）議員選舉。]
  #item()[（三）議員罷免。]
  #subpara()[主任委員遇下列情形，由議長擔任之：]
  #item()[（一）會長副會長選舉，現任正副會長任一人欲競選連任時。]
  #item()[（二）會長副會長罷免。]
  #subpara()[除主任委員外之選舉委員六人，三人由會長直接任命，三人由議長提名，經學生議會議決同意任命。並不得兼任行政中心各部部長或議員。]
  #subpara()[前款之任命，應於會長及議長任期開始後，三十日內完成。]
]

#article()[
  #para()[選舉委員之任命，如無法於規定期間內完成，致原任選舉委員任期屆滿，而無新任之選舉委員接替職位時，由原任之選舉委員代行職權，至該職位有接替者時截止。]
]

#article()[
  #para()[選舉委員如因辭職或有其他致其無法行使職權之情事而出缺者，應由原任命者於七日內，再行任命。]
  #para()[第一項接替出缺之職位者，其任期至原任者任期屆滿為止。]
  #para()[如該出缺之職位，原任命者不於規定期間截止前行任命者，得逕由另一任命者，經第四條第一項第三款之程序，指定一人代理。]
  #para()[前項代理者，至原任命者行任命後截止。]
]

#article()[
  #para()[主任委員對外代表選舉委員會，不參與日常事務運作，並於遇爭議衝突時，居中協調。]
  #para()[其餘選舉委員六人，綜理選舉罷免事務。]
]

#article()[
  #para()[選舉委員會之會議，以除主任委員外之六人行之。主任委員僅得於可否同數時，加入投票。]
]

#article()[
  #para()[下列事項，應經會議決之：]
  #subpara()[辦理選舉罷免之執行計畫。]
  #subpara()[各項選舉罷免之公告內容。]
  #subpara()[違反選舉罷免法規之裁罰事項。]
  #subpara()[其他重大事項。]
]

#article()[
  #para()[選舉委員有下列行為者，應自行辭職：]
  #subpara()[為當次選舉之候選人助選。]
  #subpara()[公開支持、反對罷免者。]
  #subpara()[偏頗選舉中特定一方。]
]

#article()[
  #para()[選舉委員會得遴聘本校學生若干人為選務人員，處理選舉罷免事務，其遴聘方式由選委會決定，但不得由候選人提出。]
]

== 選舉資格及制度

=== 選舉資格

#article()[
  #para()[本會會員皆有選舉權。]
]

#article()[
  #para()[本會會員除本法另有規定外，皆得於其選舉區，登記為候選人。]
]

#article()[
  #para()[有符合下列任一情形者，不得為本會任何選舉之候選人：]
  #subpara()[下學年不具學籍者。]
  #subpara()[擔任選舉委員者。]
  #subpara()[擔任選務人員者。]
  #subpara()[受監護或輔助宣告，尚未撤銷者。]
  #subpara()[受破產宣告確定，尚未復權者。]
  #subpara()[褫奪公權，尚未復權者。]
]

=== 選舉制度

#article()[
  #para()[會長副會長之選舉，以全校為單一選舉區，採單記投票，相對多數決之。]
  #para()[前項選舉之有效票總數，應達選舉權人總數百分之二以上，始為有效。]
  #para()[前項有效票數門檻未達者，應辦理補選；補選程序準用本法對選舉程序之規定，且不適用前項之門檻規定，但以兩次為限。]
]

#article()[
  #para()[學生議會議員之選舉，以各學院分別為一選區，採單記投票，相對多數決之，並視該選舉區應選名額為若干人，取前若干名當選。]
  #para()[前項各選區之應選名額，依下列各款規定：]
  #subpara()[美術學院：4人。]
  #subpara()[表演學院：4人。]
  #subpara()[設計學院：3人。]
  #subpara()[傳播學院：3人。]
  #subpara()[人文學院：1人。]
  #para()[前項各選區當選人數未達應選名額時，應由該學院各系所學會長或其推薦之該系所學生中，排除已有當選人之系所後，由其餘系所抽籤產生若干人補足缺額。]
]

#article()[
  #para()[雙主修者得於學生議會議員選舉時，選擇一學院為其選區。]
]

#article()[
  #para()[會長副會長選舉及學生議會議員選舉，如為同額或不足額競選時，應在選票載明對每一候選人之同意及不同意兩選項。]
  #para()[前項每一候選人，同意票應大於不同意票，方得當選。]
]

== 選舉程序

=== 候選人登記期間

#article()[
  #para()[本法所稱之候選人登記期間，指候選人登記公告發布日，至選舉公報發布日。]
]

#article()[
  #para()[選舉委員會應於下學期第十周前，發布該次選舉及候選人登記公告，內容應載明下列各款：]
  #subpara()[投票期間。]
  #subpara()[應選舉之職位。]
  #subpara()[各選區之應選名額。]
  #subpara()[候選人登記期間、應繳交之資料及費用。]
  #subpara()[選舉委員名單。]
  #subpara()[空白登記表之電子檔案。]
  #subpara()[選舉規則。]
  #subpara()[其他選舉相關之說明文字。]
]

#article()[
  #para()[候選人登記應繳交下列資料：]
  #subpara()[候選人登記表。]
  #subpara()[刊登於選舉公告之政見。]
  #subpara()[本人半身光面照片數張或電子檔。]
  #subpara()[行政規費。]
  #subpara()[候選人保證金。]
  #subpara()[符合校方規定之在學證明一份。]
  #para()[前項之表格格式、字數限制、行政規費與保證金之金額，由選舉委員會規定之。超出表格範圍或字數限制之部分，得逕不予刊登。]
  #para()[如欲登記者有於該學年度畢業之可能，應另附切結書，具結其於下學年度仍具在學資格，始得完成登記。切結書格式由選舉委員會定之。]
]

#article()[
  #para()[候選人登記應以書面或以文書型式經由通訊網路行之。]
]

#article()[
  #para()[登記人繳交之資料及資格不合規定者，選舉委員會應拒絕受理其登記。]
]

#article()[
  #para()[候選人登記期間，應不短於三日，但不得長於七日。]
]

#article()[
  #para()[登記人得於候選人登記期間截止前，撤回登記。但撤回者，於當次選舉不得再次登記。]
  #para()[候選人登記期間截止後，不得撤回登記。]
]

#article()[
  #para()[選舉委員會於受理登記時，應告知登記人其於選舉之權利及義務。]
]

#article()[
  #para()[候選人登記期間截止後，如發現候選人有不符本法對候選人資格之規定者，選舉委員會應撤銷該候選人之登記。]
]

#article()[
  #para()[已辦理登記者，如於登記後並未撤回登記，且有死亡、休學、被退學或開除學籍之情事者，選舉委員會應宣告該次選舉停止，並擇期重新辦理選舉。]
]

#article()[
  #para()[候選人登記期間截止後，選舉委員會應於選舉公報發布前，擇期辦理候選人號次抽籤。]
  #para()[候選人不克親自到場抽籤者，得以委託書委託一人代為抽籤。]
  #para()[候選人或其委託人未有到場抽籤者，由選舉委員會代為抽籤。]
]

=== 競選期間

#article()[
  #para()[本法所稱之競選期間，指選舉公報發布日，至投票期間開始前一日。]
]

#article()[
  #para()[選舉委員會應於候選人登記期間屆滿後，不遲於下學期第十二周，發布該次選舉之選舉公報，內容應載明下列各款：]
  #subpara()[投、開票時間及地點。]
  #subpara()[應選舉之職位。]
  #subpara()[各選區之應選名額。]
  #subpara()[候選人之號次、個人履歷及政見。]
  #subpara()[選舉規則。]
  #subpara()[其他選舉相關之說明文字。]
]

#article()[
  #para()[選舉委員會得於競選期間，舉辦公辦政見發表會，開放由各候選人登記參加。]
  #para()[公辦政見發表會之其他相關規定，由選舉委員會決定之。]
]

#article()[
  #para()[候選人或任何人辦理競選活動，不得違反本法之規定。]
]

#article()[
  #para()[候選人或任何人僅得於競選期間，辦理競選活動。]
  #para()[競選活動有張貼文宣品或懸掛或豎立標語、看板、旗幟、布條等廣告物者，不得妨礙公共安全或交通秩序，並應於投票日後三日內自行清除。]
  #para()[於校內辦理之競選活動，不得製造噪音。]
]

#article()[
  #para()[候選人或任何人，不得妨害其他候選人之競選活動。]
]

#article()[
  #para()[選舉委員及選務人員，不得有下列之行為或情事：]
  #subpara()[公開演講或署名推薦為候選人宣傳。]
  #subpara()[為候選人站台或亮相造勢。]
  #subpara()[印發、張貼宣傳品為候選人宣傳。]
  #subpara()[懸掛或豎立標語、看板、旗幟、布條等廣告物為候選人宣傳。]
  #subpara()[利用媒體為候選人宣傳。]
  #subpara()[參與競選遊行或拜票等活動。]
  #subpara()[其他有違行政中立之行為。]
]

=== 投票期間

#article()[
  #para()[本法所稱之投票期間，指選舉委員會發布之選舉及候選人登記公告，載明之投票期間之第一日，至其最後一日所規定之投票結束時間。]
]

#article()[
  #para()[投票期間之長短，由選舉委員會規定之，但不得長於七日。]
]

#article()[
  #para()[選舉委員會應視選舉區之需求、各學系所之位置，設立若干投票所。]
  #para()[投票所內，應設立圈票亭，供選舉人秘密投票。]
]

#article()[
  #para()[選舉之投票程序，由選舉人向選務人員領取選票，於選票圈選欄上，使用選舉委員會準備之工具圈選，並投入票匭中。]
  #para()[選舉人圈選後，不得將圈選內容示於他人。]
  #para()[第一項之投票程序，得以非紙本方案為之。其程序及執行辦法，依本法之規定，本法未規定者，適用其他法律之規定。]
]

#article()[
  #para()[投票期間，如發生或可預見將發生天災或其他不可抗力情事，致不能投票時，由選舉委員會議決，得改定投票期間或由非紙本方案為之。]
  #para()[前項改訂投票期間，應至少於改訂之投票期間前三日公告之。]
]

#article()[
  #para()[選舉人應於規定之投票時間內到投票所投票；逾時不得進入投票所。但已於規定時間內到達投票所尚未投票者，仍可投票。]
  #para()[前項所稱之到達投票所，以到達各該投票所登記領票之選舉人隊伍終端為準。無排隊隊伍者，以到達各該投票所登記領票處為準。]
]

#article()[
  #para()[選舉人投票時，應憑本人學生證或在學證明向選務人員登記，經選務人員查核選舉人身分後領取選舉票。]
  #para()[選舉委員會應設置適當機制，確保一選舉人僅得投票一次，不得重複投票。]
  #para()[二種以上選舉於同一投票所舉行投票時，選舉人應一次進入投票所領取選舉票，離開投票所後不得再次進入投票所領取選舉票。]
]

#article()[
  #para()[選舉人領得選舉票後應自行圈投。]
  #para()[因身心障礙無法自行圈投但能表示其意思者，得依其請求，由選務人員一人在場，由其陪同者，依據本人意思，眼同協助或代為圈投。]
  #para()[前項若無陪同者，得由另一名選務人員代替之。]
]

#article()[
  #para()[選票之格式，如附件一。]
]

#article()[
  #para()[選舉人於投票所有下列情事之一者，選務人員應註銷其選舉票：]
  #subpara()[未完成投票程序即離開投票所者。]
  #subpara()[重複領取選票，尚未使用者。]
  #subpara()[擅自使用他人之選票者。]
  #subpara()[於紙本投票時，遺留選票於圈票亭或投票所，未投入票匭者。]
  #para()[註銷之選舉票，應由選務人員將其標記為無效票；於紙本投票時，並應清點其數量，收回作廢。]
]

#article()[
  #para()[在投票所有下列情事之一者，選務人員應令其退出：]
  #subpara()[在場喧嚷或干擾勸誘他人投票或不投票，不服制止者。]
  #subpara()[攜帶武器或危險物品入場者。]
  #subpara()[投票完成後仍滯留於圈票亭或投票所，不聽勸阻者。]
  #subpara()[有其他不正當行為，不服制止者。]
  #para()[選舉人有前項情事之一者，令其退出時，應將其選舉票註銷。]
]

#article()[
  #para()[選舉人不得攜帶手機、攝影器材及其他具通訊或攝影功能之設備，進入投票所。]
]

=== 開票及結果公布期間

#article()[
  #para()[本法所稱之開票及結果公布期間，指投票結束時間起，至選舉結果公告發布日。]
]

#article()[
  #para()[投票期間結束後，各投票所應即由選務人員將投票結果彌封，攜至選舉委員會指定之開票所。]
  #para()[前項彌封，應將票匭之投票口封閉，並經執行彌封之選務人員簽名。]
  #para()[所有票匭皆移至開票所後，經選舉委員兩人以上確認選務人員之簽名，方得拆封。]
]

#article()[
  #para()[選舉之開票程序，依下列各款規定辦理：]
  #subpara()[選務人員由已開封之票匭中，取出一張選票。]
  #subpara()[取出選票之選務人員，公開依「（候選人號次）（候選人之姓名），一票」之格式唱票。]
  #subpara()[另一選務人員於現場人員皆得清楚監看之處，以正字記號紀錄選票數量。]
  #subpara()[取出選票之選務人員，於確認紀錄人員已劃記後，將已唱票之選票放置於現場人員皆得清楚監看之處。]
  #subpara()[重複以上各款流程，並至所有票匭開票完畢。]
  #para()[前項第二款如遇同額或不足額競選時，依「（候選人號次）（候選人之姓名），（同意或不同意），一票」之格式唱票。]
]

#article()[
  #para()[開票程序應公開為之。選舉人於不妨礙開票作業及現場秩序之範圍內，得進入開票所監看開票過程。]
  #para()[前項選舉人有致妨礙開票作業及現場秩序者，選務人員應令其退出開票所。]
]

#article()[
  #para()[選舉委員會應於開票程序結束後，整理確認選舉結果，並開票程序結束當日之三日內，發布選舉結果公告，內容應載明下列各款：]
  #subpara()[本次選舉之當選人。]
  #subpara()[各選區之應選名額。]
  #subpara()[各候選人之得票數及得票率。]
  #subpara()[當次選舉之總投票率。]
  #subpara()[其他選舉結果相關之說明文字。]
]

#article()[
  #para()[候選人之保證金，於選舉結果公告發布後七日內，退還予候選人。]
]

== 罷免

=== 罷免制度

#article()[
  #para()[會長副會長罷免案，由學生議會提出，再交由該選舉區之選舉人複決。]
  #para()[前項複決，同意票數多於不同意票數，且有效票總數大於其當選時有效票總數二分之一者，罷免案通過。不達前述任一門檻者，罷免案不通過。]
]

#article()[
  #para()[學生議會提出罷免案後，即成立之。]
]

#article()[
  #para()[學生議會議員罷免案之制度，由被罷免之議員所屬選舉區，當次選舉有效票總數百分之二五以上之選舉人連署提出，再交由該選舉區之選舉人複決。]
  #para()[前項複決，同意票數多於不同意票數，罷免案通過。不達前述門檻者，罷免案不通過。]
]

#article()[
  #para()[學生議會議員罷免案之提出，應由領銜人一人，以書面或以文書型式經由通訊網路，向選舉委員會提出。並於提出後之十四日內，將連署書暨連署名冊，付予選舉委員會。]
  #para()[未於前項十四日內簽署者，該簽署人之連署無效，不計入連署數量。]
  #para()[第一項提出及連署書暨連署名冊，格式如附件二。]
]

#article()[
  #para()[選舉委員會於收受連署書暨連署名冊後，應即核對清點，確認連署人資格及數量。]
  #para()[前項連署人資格及數量，皆符合第五十五條第一項對連署之門檻者，罷免案成立。]
]

=== 罷免程序

#article()[
  #para()[罷免之程序，除另有規定外，準用本法對選舉程序之規定。]
]

#article()[
  #para()[選舉委員會應於罷免案成立後之七日內，發布罷免公告：]
  #subpara()[被罷免人。]
  #subpara()[罷免投票之時間地點。]
  #subpara()[其他罷免相關之說明文字。]
]

#article()[
  #para()[罷免投票之時間，應訂於罷免公告發布後，十四日內。]
]

#article()[
  #para()[罷免投票之開票程序結束後，確認罷免案通過者，於選舉委員會發布罷免結果公告後，被罷免人即解職之。]
]

#article()[
  #para()[被罷免人解職後，選舉委員會應於罷免結果公告發布後十四日內，對被罷免人之職位，辦理缺額補選；缺額補選程序準用本法對選舉程序之規定。]
  #para()[前項被罷免人為學生議會議員時，先依其當選時，照選票排序取最高票未當選者遞補。如為不足額選舉時，則辦理缺額補選。]
  #para()[學生議會議員缺額補選，若無人當選時，依第十六條第三項之規定辦理。]
]

#article()[
  #para()[罷免投票之選票，格式如附件三。]
]

== 妨害選舉罷免之處份

#article()[
  #para()[有違反本法針對選舉罷免之程序規定者，依下列規定辦理：]
  #subpara()[選務人員，由選舉委員會將其解職。]
  #subpara()[候選人，由選舉委員會取消其選舉資格，並沒入保證金。]
]

#article()[
  #para()[候選人有以下任一情事者，由選舉委員會取消其選舉資格，並沒入保證金：]
  #subpara()[向其他候選人行求期約或交付財物或不正利益，約定其放棄競選或為一定競選行為者，其收受者亦同。]
  #subpara()[向選舉人行求期約或交付財物或不正利益，約定其不行使投票或為一定行為者，其收受者亦同。]
  #subpara()[以強暴、脅迫、恐嚇或其他非法之方法，妨害他人為競選、助選或行使投票權者。]
  #subpara()[以非法手法妨害選舉罷免事務者。]
  #subpara()[以非法手法使選舉產生不正結果者。]
  #subpara()[意圖使候選人當選或不當選，以文字、圖片或其他方式，散佈虛構事實，而生損害於公眾者。]
  #subpara()[候選人資格不符規定，但以詐術使選委會為候選申請登記者。]
  #subpara()[接受任何校外經費之捐助。]
  #para()[前項各款之未遂行為，以既遂斷之。]
  #para()[選務人員有前項各款行為、未遂或配合者，亦應由選舉委員會將其解職。]
]

